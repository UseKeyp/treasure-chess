datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = "native"
}

model Member {
  id                   String                @id // Chess.com id
  username             String                @unique // Chess.com username
  address              String?               @unique // Torus wallet address
  twitchUsername       String?               @unique // Twitch username
  locale               String?
  email                String?               @unique // Email address
  // --------------- LINKS --------------
  treasuresOwned       Treasure[]            @relation("treasuresOwned")
  treasuresMinted      Treasure[]            @relation("treasuresMinted")
  treasuresPlayedWhite Treasure[]            @relation("treasuresPlayedWhite")
  treasuresPlayedBlack Treasure[]            @relation("treasuresPlayedBlack")
  treasuresWon         Treasure[]            @relation("treasuresWon")
  mintPurchases        MintPurchase[]        @relation("mintPurchases")
  marketSalesSold      MarketSale[]          @relation("marketSalesSold")
  marketSalesPurchased MarketSale[]          @relation("marketSalesPurchased")
  rampWithdraws        RampWithdraw[]        @relation("rampWithdraws")
  depositOrders        DepositOrder[]        @relation("depositOrders")
  oAuthConnections     OAuthConnection[]     @relation("oAuthConnections")
  // --------------- STATE --------------
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  imageSrc             String? // Avatar URL
  masterTitle          MasterTitle? // "Grand Master" or "International Master"
  country              String // Player's country  eg. US, DE
  mintCredits          Int                   @default(3) // Mint for free!
  banned               Boolean               @default(false)
  blocked              Boolean? // Prevents minting Treasures containing this player
  refreshToken         String? // Chess.com Oauth
  accessToken          String? // Chess.com Oauth
  ramps                Ramp[]
  OAuth                OAuth[]
  promotions           PromotionsOnMembers[]
  betaAccess           Boolean                @default(false)
}

model Ramp {
  id                 String         @id @default(uuid())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  member             Member?        @relation(fields: [memberId], references: [id])
  memberId           String?
  type               RampType
  email              String?
  address            String?
  // Plaid
  accountId          String?
  accountNickname    String?
  mask               String?
  isoCurrencyCode    String?
  itemId             String? // Used to identify an Item in a webhook
  verificationStatus String? // Only used for Auth Item initiated through Automated or Manual micro-deposits
  // Wyre
  paymentMethodId    String? // Wyre
  // Coinbase
  // TODO: Replace with oAuthConnection
  accessToken        String?
  refreshToken       String?
  RampWithdraw       RampWithdraw[]
}

model Treasure {
  id                String           @id // Moves hash plus end time
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  // --------------- LINKS --------------
  // Chess.com (required)
  black             Member           @relation(name: "treasuresPlayedWhite", fields: [blackId], references: [id])
  blackId           String
  white             Member           @relation(name: "treasuresPlayedBlack", fields: [whiteId], references: [id])
  whiteId           String
  winner            Member?          @relation(name: "treasuresWon", fields: [winnerId], references: [id])
  winnerId          String?
  // NFT
  minter            Member           @relation(name: "treasuresMinted", fields: [minterId], references: [id])
  minterId          String
  owner             Member           @relation(name: "treasuresOwned", fields: [ownerId], references: [id])
  ownerId           String
  mintPurchase      MintPurchase?    @relation(name: "mintPurchase", fields: [mintPurchaseId], references: [id])
  mintPurchaseId    Int?             @unique
  // --------------- STATE --------------
  uriData           String
  tokenUri          String
  tokenId           Int?             @unique
  mintedAt          DateTime?
  title             String
  cardColor         String // white or black
  gifUrl            String // white or black
  blackRating       Int // Rating at the time of the game
  whiteRating       Int // Rating at the time of the game
  blackRatingDelta  Int // Rating at the time of the game
  whiteRatingDelta  Int
  blackMasterTitle  MasterTitle? // eg. "GM" "NM", or "IM"
  whiteMasterTitle  MasterTitle?
  timeControl       String // game time variant
  termination       Termination
  endTime           DateTime
  outcome           Outcome // "white" "black" "draw" etc.
  event             String // eg. "Live Chess"
  moves             String // pgn moves
  boardLayout       String // Final positions used to generate the image
  moveCount         Int // eg. 43
  viewCount         Int              @default(0)
  ruleVariant       String           @default("Standard") // eg. "Standard" or "Chess960"
  externalUrl       String? // Link to game on chess.com
  opening           Opening
  achievements      Achievement[] // List eg. "win/play above 2200,queen side castle,mate with a bishop"
  achievementScore  Int // eg. 10
  rarity            Rarity // eg. 10
  marketSales       MarketSale[]
  openGraphImageSrc String?
  marketSaleStatus  MarketSaleStatus @default(DELISTED)
}

model MarketSale {
  id               Int              @id @default(autoincrement())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  listedAt         DateTime? // Updated when listing tx is confirmed
  // --------------- LINKS --------------
  treasure         Treasure         @relation(fields: [treasureId], references: [id])
  treasureId       String
  seller           Member           @relation(name: "marketSalesSold", fields: [sellerId], references: [id])
  sellerId         String
  buyer            Member?          @relation(name: "marketSalesPurchased", fields: [buyerId], references: [id])
  buyerId          String?
  listTx           Transaction      @relation(name: "listTx", fields: [listTxId], references: [id])
  listTxId         String           @unique
  unlistTx         Transaction?     @relation(name: "unlistTx", fields: [unlistTxId], references: [id])
  unlistTxId       String?          @unique
  saleTransactions Transaction[]    @relation("saleTransactions")
  // --------------- STATE --------------
  status           MarketSaleStatus @default(PENDING_LISTED)
  isClosed         Boolean          @default(false)
  amount           Int
}

model DepositOrder {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // --------------- LINKS --------------
  member         Member   @relation("depositOrders", fields: [memberId], references: [id])
  memberId       String
  // --------------- STATE --------------
  amount         Float?
  paymentType    RampType
  status         TxStatus @default(UNSUBMITTED)
  // Wyre
  sourceCurrency String?
  sourceAmount   Float?
  purchaseAmount Float?
  destCurrency   String?
  paymentMethod  String?
  orderType      String? // DOMESTIC or INTERNATIONAL
  orderId        String?  @unique // Wyre orderId
  reservation    String?  @unique // Wyre reservation
}

model MintPurchase {
  id                Int                      @id @default(autoincrement())
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  // --------------- LINKS --------------
  member            Member                   @relation("mintPurchases", fields: [memberId], references: [id])
  memberId          String
  treasure          Treasure?                @relation("mintPurchase")
  // --------------- STATE --------------
  gameId            String
  gameEndTime       String
  title             String // Treasure title
  // Order details
  paymentType       String                   @default("WYRE") // WYRE, MINTCREDIT
  status            RampStatus               @default(PENDING)
  // Wyre or Stripe
  orderStatus       MintPurchaseOrderStatus?
  orderId           String?                  @unique // Wyre orderId
  reservation       String?                  @unique // Wyre reservation
  // Blockchain
  staleTransactions Transaction[]            @relation("staleMintTransactions")
  transaction       Transaction?             @relation(fields: [transactionId], references: [id])
  transactionId     String?                  @unique
}

model OAuth {
  state         String   @id
  codeChallenge String
  codeVerifier  String
  createdAt     DateTime @default(now())
  member        Member?  @relation(fields: [memberId], references: [id])
  memberId      String?
}

model OAuthConnection {
  id           String              @id @default(uuid())
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  member       Member              @relation("oAuthConnections", fields: [memberId], references: [id])
  memberId     String
  type         OAuthConnectionType
  revoked      Boolean             @default(false)
  refreshToken String?
  accessToken  String
  expiration   DateTime?
}

model RampWithdraw {
  id            String      @id @default(uuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  status        RampStatus  @default(PENDING)
  toAddress     String
  amount        Int
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  transactionId String      @unique
  member        Member?     @relation("rampWithdraws", fields: [memberId], references: [id])
  memberId      String?
  ramp          Ramp        @relation(fields: [rampId], references: [id])
  rampId        String
}

model Transaction {
  id                   String        @id
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  // --------------- STATE --------------
  status               TxStatus      @default(SUBMITTED)
  gasLimit             Int           @default(0)
  maxPriorityFeePerGas Int           @default(0)
  maxFeePerGas         Int           @default(0)
  mintPurchase         MintPurchase?
  marketSaleList       MarketSale?   @relation("listTx")
  marketSaleUnlist     MarketSale?   @relation("unlistTx")
  marketSaleSale       MarketSale?   @relation("saleTransactions", fields: [marketSaleSaleId], references: [id])
  marketSaleSaleId     Int?
  rampWithdraw         RampWithdraw?
  MintPurchase         MintPurchase? @relation("staleMintTransactions", fields: [mintPurchaseId], references: [id])
  mintPurchaseId       Int?
}

model Promotion {
  id          Int                   @id @default(autoincrement())
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  rewardType  PromotionRewardType   @default(MINT_CREDIT)
  type        PromotionType
  mintCredits Int? // How many mint credits should be given
  enabled     Boolean               @default(false)
  members     PromotionsOnMembers[]
}

model PromotionsOnMembers {
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  member      Member    @relation(fields: [memberId], references: [id])
  memberId    String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  promotionId Int

  @@id([memberId, promotionId])
}

enum RampType {
