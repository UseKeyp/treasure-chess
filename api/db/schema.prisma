datasource db {
  // provider = "sqlite"
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = "native"
}

model Member {
  id                   String         @id // Chess.com id
  username             String         @unique // Chess.com username
  address              String?        @unique // Torus wallet address
  // --------------- LINKS --------------
  treasuresOwned       Treasure[]     @relation("treasuresOwned")
  treasuresMinted      Treasure[]     @relation("treasuresMinted")
  treasuresPlayedWhite Treasure[]     @relation("treasuresPlayedWhite")
  treasuresPlayedBlack Treasure[]     @relation("treasuresPlayedBlack")
  treasuresWon         Treasure[]     @relation("treasuresWon")
  mintPurchases        MintPurchase[] @relation("mintPurchases")
  marketSalesSold      MarketSale[]   @relation("marketSalesSold")
  marketSalesPurchased MarketSale[]   @relation("marketSalesPurchased")
  // --------------- STATE --------------
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  imageSrc             String? // Avatar URL
  masterTitle          String? // "Grand Master" or "International Master"
  country              String // Player's country  eg. US, DE
  mintCredits          Int            @default(3) // Mint for free!
  // Oauth
  refreshToken         String?
}

model Treasure {
  id               String        @id // Moves hash plus end time
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  // --------------- LINKS --------------
  // Chess.com (required)
  black            Member        @relation(name: "treasuresPlayedWhite", fields: [blackId], references: [id])
  blackId          String
  white            Member        @relation(name: "treasuresPlayedBlack", fields: [whiteId], references: [id])
  whiteId          String
  winner           Member?       @relation(name: "treasuresWon", fields: [winnerId], references: [id])
  winnerId         String?
  // NFT
  minter           Member        @relation(name: "treasuresMinted", fields: [minterId], references: [id])
  minterId         String
  owner            Member        @relation(name: "treasuresOwned", fields: [ownerId], references: [id])
  ownerId          String
  mintPurchase     MintPurchase? @relation(name: "mintPurchase", fields: [mintPurchaseId], references: [id])
  mintPurchaseId   Int?          @unique
  // --------------- STATE --------------
  uriData          String
  tokenUri         String
  tokenId          Int?          @unique
  mintedAt         DateTime?
  title            String
  cardColor        String // white or black
  gifUrl           String // white or black
  blackRating      Int // Rating at the time of the game
  whiteRating      Int // Rating at the time of the game
  blackRatingDelta Int // Rating at the time of the game
  whiteRatingDelta Int
  blackMasterTitle String? // eg. "GM" "NM", or "IM"
  whiteMasterTitle String?
  timeControl      String // game time variant
  termination      String // eg. "Checkmate",  "Resignation", "Stalemate", "Insufficient Material"
  endTime          DateTime
  outcome          String // "white" "black" "draw" etc.
  event            String // eg. "Live Chess"
  moves            String // pgn moves
  boardLayout      String // Final positions used to generate the image
  moveCount        Int // eg. 43
  ruleVariant      String        @default("Standard") // eg. "Standard" or "Chess960"
  externalUrl      String? // Link to game on chess.com
  opening          String // eg. "Queen's Gambit"
  achievements     String // List eg. "win/play above 2200,queen side castle,mate with a bishop"
  achievementScore Int // eg. 10
  rarity           String // eg. 10
  marketSales      MarketSale[]
}

model MarketSale {
  id         Int              @id @default(autoincrement())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime
  listedAt   DateTime // Updated when listing tx is confirmed
  // --------------- LINKS --------------
  treasure   Treasure         @relation(fields: [treasureId], references: [id])
  treasureId String
  seller     Member           @relation(name: "marketSalesSold", fields: [sellerId], references: [id])
  sellerId   String
  buyer      Member?          @relation(name: "marketSalesPurchased", fields: [buyerId], references: [id])
  buyerId    String?
  listTx     Transaction      @relation(name: "listTx", fields: [listTxId], references: [id])
  listTxId   String           @unique
  unlistTx   Transaction?     @relation(name: "unlistTx", fields: [unlistTxId], references: [id])
  unlistTxId String?          @unique
  saleTx     Transaction?     @relation(name: "saleTx", fields: [saleTxId], references: [id])
  saleTxId   String?          @unique
  // --------------- STATE --------------
  status     MarketSaleStatus @default(PENDING_LISTED)
  isClosed   Boolean
  amount     Int
}

model MintPurchase {
  id          Int                      @id @default(autoincrement())
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  // --------------- LINKS --------------
  member      Member                   @relation("mintPurchases", fields: [memberId], references: [id])
  memberId    String
  treasure    Treasure?                @relation("mintPurchase")
  // --------------- STATE --------------
  gameId      String
  gameEndTime String
  title       String                   @default("Cool game") // User's desired title
  // Order
  paymentType String                   @default("WYRE") // WYRE, MINTCREDIT
  orderStatus MintPurchaseOrderStatus?
  // Wyre
  orderId     String?                  @unique // Wyre orderId
  reservation String?                  @unique // Wyre reservation
  // NFT
  txHash      String?
  txStatus    TxStatus                 @default(UNSUBMITTED)
}

model OAuth {
  state         String   @id
  codeChallenge String
  codeVerifier  String
  createdAt     DateTime @default(now())
}

model Transaction {
  id               String      @id
  createdAt        DateTime    @default(now())
  updatedAt        DateTime
  // --------------- STATE --------------
  txStatus         TxStatus    @default(SUBMITTED)
  MarketSaleList   MarketSale? @relation("listTx")
  MarketSaleUnlist MarketSale? @relation("unlistTx")
  MarketSaleSale   MarketSale? @relation("saleTx")
}

enum MarketSaleStatus {
  PENDING_LISTED
  LISTED
  PENDING_SOLD
  SOLD
  PENDING_DELISTED
  DELISTED
}

enum TxStatus {
  UNSUBMITTED
  SUBMITTED
  COMPLETE
  FAILED
}

enum MintPurchaseOrderStatus {
  RESERVATION
  COMPLETE
}
