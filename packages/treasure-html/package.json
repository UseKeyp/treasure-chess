{
  "name": "@treasure-chess/treasure-html",
  "version": "1.0.7-staging.2",
  "description": "Generates a beautiful html card for a treasure.",
  "main": "dist/index.js",
  "module": "src/index.js",
  "scripts": {
    "test": "babel-node tests/card.test.js",
    "test:watch": "nodemon --watch src --ext \"js,ts,tsx\" --exec \"babel-node tests/card.test.js\"",
    "build": "babel src -d dist",
    "build:watch": "nodemon --watch src --ext \"js,ts,tsx\" --ignore dist --exec \"yarn build\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@babel/node": "^7.16.0",
    "@babel/preset-env": "^7.16.0",
    "nodemon": "^2.0.15"
  }
}
