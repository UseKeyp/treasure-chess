{
  "private": true,
  "workspaces": {
    "packages": [
      "api",
      "web",
      "packages/*"
    ]
  },
  "scripts": {
    "build-storybook": "yarn rw storybook --build && cp web/public/mockServiceWorker.js web/public/storybook",
    "chromatic": "chromatic --project-token=cafed242b299 --storybook-build-dir web/public/storybook",
    "seed": "yarn rw exec seed",
    "build-packages": "lerna exec --no-private -- yarn build",
    "vercel-build": "yum install libuuid-devel libmount-devel zlib && cp /lib64/{libuuid,libmount,libblkid,libz}.so.1 node_modules/canvas/build/Release/ && rm -rf api/src/functions/screenshot && yarn build-packages && yarn rw deploy vercel"
  },
  "prisma": {
    "seed": "yarn rw exec seed"
  },
  "devDependencies": {
    "@discordjs/rest": "^0.4.1",
    "@ethersproject/wallet": "^5.5.0",
    "@netlify/zip-it-and-ship-it": "^4.23.0",
    "@redwoodjs/core": "^1.0.0",
    "babel-loader": "^8.2.3",
    "chromatic": "^5.9.2",
    "csv-parse": "^5.0.4",
    "discord-api-types": "^0.32.0",
    "eslint-plugin-prettier": "^4.0.0",
    "lerna": "^4.0.0",
    "random-username-generator": "^1.0.4",
    "sharp": "^0.29.3"
  },
  "eslintConfig": {
    "extends": "@redwoodjs/eslint-config",
    "root": true,
    "rules": {
      "no-console": 2
    }
  },
  "engines": {
    "node": ">=14.17 <=16.x",
    "yarn": ">=1.15 <2"
  },
  "dependencies": {
    "dotenv": "^16.0.0"
  }
}
